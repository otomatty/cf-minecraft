{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024",
			"dom",
			"dom.iterable",
			"dom.asynciterable"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [
			"@webgpu/types",
			"vite/client"
		],
		"strict": true,
		"noEmit": true,
		"noUncheckedIndexedAccess": false,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src/client",
		"src/shared",
		"src/wasm-url.d.ts"
	],
	"exclude": [
		"src/**/*.test.ts"
	]
}
